# Compiled Python bytecode — MUST be ignored.
# pii-core-lib carries credential-pattern tests whose compiled bytecode
# embeds real-looking secrets (AWS access key shapes, Stripe keys, JWT
# samples). Committing __pycache__/*.pyc artifacts triggers GitHub push
# protection and blocks the entire branch push.
*.py[cod]
**/*.pyc
**/*.pyo
__pycache__/
**/__pycache__/
**/__pycache__/*

# Editor / IDE
.idea/
.vscode/
*.swp

# Generated by macOS
.DS_Store

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Hydra
.hydra/
outputs/
multirun/
